# Twitch API credentials
# Create an app at https://dev.twitch.tv/console/apps
# These are SERVER-SIDE only — never prefix with VITE_
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# Optional: override the streamer username (default: ohnahji)
TWITCH_USERNAME=ohnahji

# CORS allowlist for api/twitch-stats.ts (production frontend origin).
# Local dev falls back to http://localhost:5173 when unset.
FRONTEND_URL=https://your-app.vercel.app
